// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COMPANY_ADMIN
  OPERATOR
}

// Un tenant = un taller/carrocero cliente ("empresa").
model Company {
  id        String   @id @default(cuid())
  name      String
  // TODO fase 5: logo/CIF/dirección para membrete de los PDF generados.
  createdAt DateTime @default(now())

  // Correlativo de numeración de expediente, propio de esta empresa (no
  // global) — se incrementa de forma atómica en createDossier(), evita la
  // fragilidad del "HI" & texto+1 del FileMaker original.
  nextDossierNumber Int @default(0)

  users       User[]
  invitations Invitation[]
  dossiers    Dossier[]

  @@map("companies")
}

// Sin contraseña: la identidad viene siempre de Google. Un User es siempre
// miembro de una empresa (companyId requerido) — el "super_admin" NO es un
// User, es una capacidad global que se concede solo por estar en la env var
// SUPER_ADMIN_EMAILS (ver src/lib/superAdmin.ts). Así el mismo email puede
// ser super_admin Y, por separado, dueño/miembro de una empresa (ej. el
// propio operador del SaaS probando o usando su propio taller) sin chocar.
model User {
  id        String   @id @default(cuid())
  companyId String
  googleId  String   @unique
  email     String   @unique
  name      String
  role      Role
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("users")
}

// Alta pendiente: una fila por email invitado a una empresa con un rol,
// hasta que esa persona hace login con Google por primera vez y se
// vincula sola (ver src/app/actions/auth.ts).
model Invitation {
  id         String    @id @default(cuid())
  companyId  String
  email      String
  role       Role
  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([email])
  @@map("invitations")
}

// ---------------------------------------------------------------------
// Fase 1: núcleo + certificado. El "expediente" original de FileMaker.
// Cada tabla satélite es 1:1 con Dossier (ver documento de diseño,
// sección "Modelo de datos" — se mantienen separadas en vez de fusionarse
// porque no comparten forma de campos entre sí).
// ---------------------------------------------------------------------

model Dossier {
  id        String   @id @default(cuid())
  companyId String
  /// Numeración "HI"+correlativo propio de la empresa (antes
  /// EXPEDIENTE::Numero_de_expediente).
  number    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer?
  dealer   Dealer?
  coc      Coc?

  @@unique([companyId, number])
  @@index([companyId])
  @@map("dossiers")
}

// "Cliente" — antes tabla CLIENTE.
model Customer {
  id           String  @id @default(cuid())
  dossierId    String  @unique
  name         String?
  phone        String?
  email        String?
  contactName  String?
  contactPhone String?
  notes        String?

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@map("customers")
}

// "Concesionario" — antes tabla CONCESIONARIO. phone/contactPhone eran
// NUMBER en FileMaker (ver Mejoras #3 del documento de diseño): un
// teléfono no es una cantidad, se guarda como texto para no perder ceros
// a la izquierda ni romper con prefijos.
model Dealer {
  id           String  @id @default(cuid())
  dossierId    String  @unique
  name         String?
  phone        String?
  email        String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  notes        String?

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@map("dealers")
}

// "COC" (Certificado de Conformidad) — transcripción de los datos
