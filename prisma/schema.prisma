// "Carrozado" — antes tabla CARROZADO. Dimensiones y materiales de la caja
// fabricada, entrada manual. Los ~30 campos calculados de peso/material
// (Metros_lineales_*, Peso_total_*, etc.) NO se guardan como columnas — se
// derivan en src/lib/calculations/bodywork.ts (ver Mejoras #1 y sección
// "Motor de cálculo" del documento de diseño).
model Bodywork {
  id        String @id @default(cuid())
  dossierId String @unique

  /// CARROZADO::Tipo_carrozado
  bodyType String?

  /// CARROZADO::Tipo_de_piso
