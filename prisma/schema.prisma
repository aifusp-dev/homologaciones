  thirdBrakeLight String?

  /// Material_actosreglamentarios::V23roja
  v23Red String?

  /// Material_actosreglamentarios::V23blanca
  v23White String?

  /// Material_actosreglamentarios::Faldillaabsorbente
  spraySuppressionFlap String?

  /// Material_actosreglamentarios::Guardabarros
  mudguard String?

  /// Material_actosreglamentarios::Observaciones_ordenfabricacion
  manufacturingOrderRemarks String?

  /// Material_actosreglamentarios::fecha_orden_fabricacion
  manufacturingOrderDate String?

