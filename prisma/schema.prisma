// "Actos reglamentarios / Informes H" — sin tabla de origen directa (en
// FileMaker estos números iban escritos a mano en el propio layout PDF de
// cada certificado). Aquí se guardan una vez por expediente y se muestran
// en todas las cajas "Actos reglamentarios" de Informe Previo, Orden de
// Fabricación, Certificado de Carrozado, Certificado parte 2 y Registro
// COP — cada caja solo pinta las líneas que tengan valor.
model RegulatoryActNumbers {
  id        String @id @default(cuid())
  dossierId String @unique

  /// Alumbrado y señalización 48R08
  lightingActNumber String?

  /// Dispositivos antiproyección UE 109/2011
  spraySuppressionActNumber String?

  /// Masas y dimensiones UE 1230/2012
  massesActNumber String?

  /// Placas de matrícula traseras UE 1003/2010
  rearPlateActNumber String?

  /// Protección trasera 58R03
  rearProtectionActNumber String?

  /// Compatibilidad electromagnética 10R06
  emcActNumber String?

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@map("regulatory_act_numbers")
}
